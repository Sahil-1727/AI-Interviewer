GEMINI_API_KEY=your_gemini_api_key_here
# Setting DATABASE_URL enables PostgreSQL interview and session storage.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_interviewer

# Experimental automatic voice turns. Values are seconds unless named otherwise.
INITIAL_THINKING_PROMPT_SECONDS=15
INITIAL_ANSWER_TIMEOUT_SECONDS=10
END_OF_ANSWER_SILENCE_SECONDS=5
DEEPGRAM_SILENCE_FALLBACK_SECONDS=2.8
COMMAND_CHECKPOINT_SECONDS=1
AUDIO_LEVEL_THRESHOLD=0.025
MIN_ACTIVITY_SECONDS=0.25
ACTIVITY_GAP_SECONDS=0.2
PLAYBACK_SETTLE_SECONDS=0.6
AUDIO_SAMPLE_INTERVAL_MS=50
MAX_CAPTURE_SECONDS=600
REQUEST_TIMEOUT_SECONDS=90
COMPLETION_MIN_LOGPROB=-0.25
COMPLETION_MAX_NO_SPEECH_PROB=0.1

# Local models, conversation orchestration and bounded audio.
# Whisper remains the local default; Deepgram streaming uses the browser mic.
STT_PROVIDER=whisper
# STT_PROVIDER=deepgram
TTS_PROVIDER=edge
# TTS_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# DEEPGRAM_COMMAND_MIN_CONFIDENCE=0.85
# DEEPGRAM_CONNECT_TIMEOUT_SECONDS=15
# DEEPGRAM_FINALIZE_TIMEOUT_SECONDS=8
# DEEPGRAM_UTTERANCE_END_MS=1500
# DEEPGRAM_FINAL_TURN_GRACE_SECONDS=0.8
# STREAM_MAX_CONNECTIONS_PER_WORKER=2
# LiveKit is an optional primary voice transport. Keep disabled unless the
# separate worker is configured and real-audio behavior has been verified.
# Set LIVEKIT_ENABLED=1 to use LiveKit as the browser's only active voice transport.
# The separate Python worker uses LiveKit Inference (AssemblyAI, Gemma, Fish Audio).
# Keep these secrets in local environment/Render settings; never commit them.
# LIVEKIT_ENABLED=1
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_SHARED_SECRET=generate-a-random-secret-of-at-least-32-characters
# LIVEKIT_AGENT_NAME=ai-interviewer
# LIVEKIT_AGENT_MODE=conversational
# INTERVIEW_BACKEND_URL=https://your-flask-app.onrender.com
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=3
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
TTS_TIMEOUT_SECONDS=60
SEGMENT_SECONDS=25
MAX_SEGMENT_SECONDS=90
MAX_PENDING_SEGMENTS=8
MAX_ANSWER_CHARACTERS=60000
MIN_VOICED_SECONDS=0.2
STT_MIN_LOGPROB=-1
STT_MAX_NO_SPEECH_PROB=0.6
POLL_INTERVAL_MS=600
NOISE_FLOOR_MULTIPLIER=2.5
NOISE_FLOOR_SMOOTHING=0.05
CONVERSATION_WORKERS=2
CONVERSATION_QUEUE_LIMIT=4
CONVERSATION_STALE_SECONDS=240
CONVERSATION_RETENTION_SECONDS=86400
# Deployment: see docs/render-free.md for PostgreSQL and Render settings.
# SECRET_KEY=generate-a-private-random-value
# SESSION_COOKIE_SECURE=1  # Set to 1 when serving over HTTPS.
# APP_ENV=production
# MAX_REQUEST_BYTES=12582912
# SESSION_RETENTION_SECONDS=86400
# CSRF_ENABLED=1
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_INTERVIEW_PER_MINUTE=60
# RATE_LIMIT_AUDIO_PER_MINUTE=30
# RATE_LIMIT_AUTH_PER_MINUTE=12
# New accounts default to two interview creations per UTC day. The super-admin
# can adjust this limit per account from the private operations page.
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT_SECONDS=180
# GUNICORN_GRACEFUL_TIMEOUT_SECONDS=180
# INTERVIEW_SESSION_DIR=/path/to/private/sessions
# CONVERSATION_STATE_DIR=/path/to/private/conversations
# FLASK_DEBUG=1
